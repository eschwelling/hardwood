APP_NAME=Rafters
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=hardwood
DB_USERNAME=hardwood
DB_PASSWORD=hardwood

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Moderation: posts are held for manual review if unset or if the API call fails.
OPENAI_API_KEY=

# Admin mode: seeded on boot. Leave unset locally to skip seeding an admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Game media lookup: when a memory has a date, we try to find its box score
# (balldontlie.io) and a highlight video (YouTube Data API v3). Both are
# optional — unset either one and that piece of the lookup silently no-ops.
BALLDONTLIE_API_KEY=
YOUTUBE_API_KEY=
